@import url("unity-theme://default");

/* The open list of a dropdown is attached to the panel, outside the menu's own tree, so its look is set here. */

.unity-base-dropdown__container-outer {
    background-color: #0A0E22;
    border-width: 2px;
    border-color: #FFD166;
    border-radius: 6px;
}

.unity-base-dropdown__container-inner {
    background-color: #0A0E22;
    border-width: 0;
    padding: 6px 0;
}

.unity-base-dropdown__item {
    height: 52px;
    padding: 0 14px;
    background-color: rgba(0, 0, 0, 0);
}

.unity-base-dropdown__item:hover,
.unity-base-dropdown__item:focus,
.unity-base-dropdown__item:checked {
    background-color: rgba(255, 209, 102, 0.16);
}

.unity-base-dropdown__label {
    font-size: 24px;
    color: #E6ECFF;
}

.unity-base-dropdown__checkmark {
    width: 24px;
    height: 24px;
    -unity-background-image-tint-color: #FFD166;
}
