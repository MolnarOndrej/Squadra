/*
 * Squadra mission editor. A desktop tool: laid out in real pixels by its own panel settings, so a
 * larger window shows more of the map instead of larger controls. The colors are the menu's.
 */

:root {
    --void: #05060F;
    --panel: #0A0E22;
    --panel-raised: #141A3A;
    --line: rgba(135, 145, 176, 0.4);
    --line-faint: rgba(135, 145, 176, 0.22);
    --text: #E6ECFF;
    --text-dim: #8791B0;
    --accent: #FFD166;
    --accent-wash: rgba(255, 209, 102, 0.14);
    --error: #FF6B7A;
    --warning: #FFB454;
}

.editor-root {
    flex-grow: 1;
    color: var(--text);
    font-size: 13px;
    background-color: var(--void);
}

.editor-content {
    flex-grow: 1;
}

.hidden {
    display: none;
}

/* ------------------------------------------------------------------ toolbar */

.toolbar {
    flex-direction: row;
    flex-shrink: 0;
    align-items: center;
    height: 44px;
    padding: 0 8px;
    background-color: var(--panel);
    border-bottom-width: 1px;
    border-color: var(--line-faint);
}

.toolbar__gap {
    width: 1px;
    height: 22px;
    margin: 0 8px;
    background-color: var(--line-faint);
}

.toolbar__spring {
    flex-grow: 1;
}

.toolbar__zoom {
    width: 62px;
    -unity-text-align: middle-center;
    color: var(--text-dim);
}

.toolbar__file {
    margin-right: 6px;
    color: var(--text-dim);
    -unity-text-align: middle-right;
}

.toolbar__file--unsaved {
    color: var(--accent);
}

/* Buttons. The first rule keeps the resting look when a button merely has the focus. */

.tool-button,
.tool-button:focus {
    height: 30px;
    margin: 0 2px;
    padding: 0 12px;
    font-size: 13px;
    color: var(--text);
    background-color: var(--panel-raised);
    border-width: 1px;
    border-color: var(--line);
    border-radius: 4px;
}

.tool-button:hover {
    color: var(--accent);
    border-color: var(--accent);
    background-color: var(--accent-wash);
}

.tool-button:active {
    background-color: rgba(255, 209, 102, 0.28);
}

.tool-button:disabled {
    opacity: 1;
    color: rgba(135, 145, 176, 0.5);
    border-color: var(--line-faint);
    background-color: rgba(20, 26, 58, 0.5);
}

.tool-button--square {
    width: 30px;
    padding: 0;
    font-size: 17px;
}

/* An armed tool, or a view option that is on. */
.tool-button--on,
.tool-button--on:focus,
.tool-button--on:hover {
    color: #05060F;
    border-color: var(--accent);
    background-color: var(--accent);
}

/* ------------------------------------------------------------------ canvas */

.workspace {
    flex-grow: 1;
    flex-direction: row;
}

.canvas {
    flex-grow: 1;
    background-color: #080A18;
}

.canvas__node-label {
    padding: 0 4px;
    font-size: 13px;
    color: var(--text);
    -unity-font-style: bold;
    text-shadow: 0 0 4px #05060F;
    white-space: nowrap;
}

.canvas__node-label--selected {
    color: var(--accent);
}

.canvas__distance-label {
    padding: 1px 5px;
    font-size: 12px;
    color: var(--text);
    background-color: rgba(10, 14, 34, 0.9);
    border-width: 1px;
    border-color: var(--line-faint);
    border-radius: 3px;
    white-space: nowrap;
}

.canvas__distance-label--selected {
    color: var(--accent);
    border-color: var(--accent);
}

/* ------------------------------------------------------------------ side panel */

.side-panel {
    flex-shrink: 0;
    width: 340px;
    background-color: var(--panel);
    border-left-width: 1px;
    border-color: var(--line-faint);
}

.section {
    padding: 12px 14px 10px 14px;
    border-bottom-width: 1px;
    border-color: var(--line-faint);
}

.section__title {
    margin-bottom: 8px;
    font-size: 11px;
    letter-spacing: 2px;
    -unity-font-style: bold;
    color: var(--text-dim);
}

.section__note {
    color: var(--text-dim);
    white-space: normal;
}

.row {
    flex-direction: row;
    align-items: center;
    min-height: 28px;
    margin-bottom: 4px;
}

.row__label {
    flex-shrink: 0;
    width: 104px;
    color: var(--text-dim);
}

.row__value {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
    color: var(--text);
}

.row__control {
    flex-grow: 1;
    flex-shrink: 1;
    margin: 0;
}

.row__error {
    margin: -2px 0 6px 104px;
    font-size: 12px;
    color: var(--error);
    white-space: normal;
}

/* Text fields and dropdowns */

.row__control .unity-base-text-field__input,
.row__control .unity-base-popup-field__input {
    height: 26px;
    padding: 0 6px;
    font-size: 13px;
    color: var(--text);
    background-color: var(--void);
    border-width: 1px;
    border-color: var(--line);
    border-radius: 3px;
    --unity-cursor-color: #E6ECFF;
    --unity-selection-color: rgba(255, 209, 102, 0.35);
}

.row__control:hover .unity-base-text-field__input,
.row__control:hover .unity-base-popup-field__input {
    border-color: var(--text-dim);
}

.row__control:focus .unity-base-text-field__input,
.row__control .unity-base-text-field__input:focus,
.row__control:focus .unity-base-popup-field__input {
    border-color: var(--accent);
}

.row__control .unity-base-popup-field__text {
    color: var(--text);
}

.row__control .unity-base-popup-field__arrow {
    -unity-background-image-tint-color: #E6ECFF;
}

/* Text that is not a valid value stays in its field, marked, until it is corrected. */
.row__control--invalid .unity-base-text-field__input,
.row__control--invalid:hover .unity-base-text-field__input,
.row__control--invalid:focus .unity-base-text-field__input,
.row__control--invalid .unity-base-text-field__input:focus {
    border-color: var(--error);
    background-color: rgba(255, 107, 122, 0.12);
}

/* Players */

.player {
    flex-direction: row;
    align-items: center;
    min-height: 30px;
    margin-bottom: 4px;
}

.player__swatch {
    flex-shrink: 0;
    width: 14px;
    height: 14px;
    margin-right: 8px;
    border-radius: 7px;
}

.player__id {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
}

.player__color {
    flex-grow: 0;
    flex-shrink: 0;
    width: 104px;
}

.player__add-id {
    flex-grow: 1;
    flex-shrink: 1;
}

.small-button,
.small-button:focus {
    height: 26px;
    margin: 0 0 0 6px;
    padding: 0 8px;
    font-size: 12px;
}

.players__add {
    margin-top: 6px;
    padding-top: 8px;
    border-top-width: 1px;
    border-color: var(--line-faint);
}

/* Validation */

.validation__summary {
    margin-bottom: 6px;
    color: var(--text-dim);
    white-space: normal;
}

.validation__summary--errors {
    color: var(--error);
}

.validation__summary--warnings {
    color: var(--warning);
}

.issue,
.issue:focus {
    flex-direction: row;
    align-items: flex-start;
    margin: 0 0 4px 0;
    padding: 6px 8px;
    background-color: rgba(20, 26, 58, 0.6);
    border-width: 0 0 0 3px;
    border-color: var(--warning);
    border-radius: 2px;
}

.issue--error,
.issue--error:focus {
    border-color: var(--error);
}

.issue:hover {
    background-color: var(--panel-raised);
}

.issue__text {
    flex-shrink: 1;
    font-size: 12px;
    color: var(--text);
    white-space: normal;
    -unity-text-align: upper-left;
}

.issue__where {
    font-size: 11px;
    color: var(--text-dim);
    white-space: normal;
    -unity-text-align: upper-left;
}

/* Scroll bars: a thin thumb and no arrow buttons, in the panel's and the dialog's lists. */

.editor-root .unity-scroller--vertical {
    width: 10px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.editor-root .unity-scroller__low-button,
.editor-root .unity-scroller__high-button {
    display: none;
}

.editor-root .unity-scroller--vertical > .unity-scroller__slider {
    margin: 0;
}

.editor-root .unity-scroller--vertical .unity-base-slider__tracker {
    border-width: 0;
    background-color: rgba(135, 145, 176, 0.08);
}

.editor-root .unity-scroller--vertical .unity-base-slider__dragger {
    left: 2px;
    width: 6px;
    border-width: 0;
    border-radius: 3px;
    background-color: rgba(135, 145, 176, 0.5);
}

.editor-root .unity-scroller--vertical .unity-base-slider__dragger:hover {
    background-color: var(--accent);
}

/* ------------------------------------------------------------------ status line */

.status-bar {
    flex-direction: row;
    flex-shrink: 0;
    align-items: center;
    height: 26px;
    padding: 0 12px;
    background-color: var(--panel);
    border-top-width: 1px;
    border-color: var(--line-faint);
}

.status-bar__status {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
    color: var(--text);
}

.status-bar__hint {
    flex-shrink: 0;
    color: var(--text-dim);
}

/* ------------------------------------------------------------------ dialog */

.modal {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(5, 6, 15, 0.78);
}

.dialog {
    width: 560px;
    max-width: 92%;
    max-height: 86%;
    padding: 22px 24px 18px 24px;
    background-color: var(--panel);
    border-width: 1px;
    border-color: var(--line);
    border-radius: 8px;
}

.dialog__title {
    margin-bottom: 10px;
    font-size: 18px;
    -unity-font-style: bold;
    white-space: normal;
}

.dialog__scroll {
    flex-shrink: 1;
}

.dialog__message {
    font-size: 13px;
    color: var(--text);
    white-space: normal;
}

.dialog__buttons {
    flex-direction: row;
    flex-shrink: 0;
    justify-content: flex-end;
    margin-top: 18px;
}

.dialog__button,
.dialog__button:focus {
    min-width: 92px;
    margin: 0 0 0 8px;
}

/* In a dialog the keyboard matters: the focused answer is outlined. */
.dialog__button:focus {
    border-color: var(--accent);
}

.dialog__button--primary,
.dialog__button--primary:focus {
    color: var(--accent);
}
